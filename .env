# local | cloud
DEPLOY_MODE=local
PORT=6000

# Mongo connection. Local mode: a local mongod instance. Cloud mode: your hosted cluster.
MONGO_URI=mongodb://127.0.0.1:27017/bingo1020_local

# Required when DEPLOY_MODE=local - identifies this shop's install, constant forever.
SHOP_ID=6a622b4fa28df3618e2fb974



# JWT
JWT_SECRET=4a57fba877d81cd642381561aec95158e2c316fb91cf6c17e0cf3e14a89f83d6
JWT_EXPIRES_IN=7d

# Local mode only: where to push local->cloud sync batches, and the per-shop API key
# issued by the Super Admin app when this shop was created there.
CLOUD_SYNC_URL=http://127.0.0.1:6100
CLOUD_SYNC_API_KEY=4a072314273b23dd9cf3bfa7a118ccece830a7ec83f9278d

# Cloud mode only: comma separated per-shop API keys accepted on /api/sync/ingest,
# in the form shopId:key,shopId2:key2 (a real deployment would look these up from the
# shops collection instead - see src/middleware/auth.js requireShopApiKey).
CLOUD_SHOP_API_KEYS=

# CORS - comma separated list of allowed origins (LAN devices generally don't send an
# Origin header for plain HTTP API calls, this mainly matters for the web-based
# Super Admin app in cloud mode).
CORS_ORIGINS=*

# This shop's signed license key (see src/utils/license.js). Binds to this machine on
# first startup. Missing/invalid shows a warning banner in the Admin app.
LICENSE_KEY=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzaG9wSWQiOiI2YTYyMmI0ZmEyOGRmMzYxOGUyZmI5NzQiLCJpYXQiOjE3ODQ4MjgzMTB9.gdHGuMdQZVX6-8wvCy_fypH5FGYVqJWtvWHuuCHGAonoKnvopBxGYMRHVqpyvvQaNEq5L1-Q2wI1hPGqWLi1uav7Y3wir-FA32Dz4W6izjVrtZIBuBZ6stOWAk3aF_e94qTHHZ4ayJ97mHbrw1ej7gU41ZtGYWsilfbx_4oyT68f7rSbz_nBdDNMwKchwjMDrFQ-DlaaXwoqsuQQy7LxEyzFbGZAgGb2kegQK9A7W_cqr-X7HpouAiNfMZau5HOKAFrlBcNNOyi2Pg5-jUPUYaSsHbY3MtX7eAoueiQww1ljlDk9BJW0oXhmNMKNpWwwZSbVnMlEsWTt4OfxpN5oOA






