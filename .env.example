# local | cloud
DEPLOY_MODE=local
PORT=6000

# Mongo connection. Local mode: a local mongod instance. Cloud mode: your hosted cluster.
MONGO_URI=mongodb://127.0.0.1:27017/bingo1020_local

# Required when DEPLOY_MODE=local - identifies this shop's install, constant forever.
SHOP_ID=shop_001

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Local mode only: where to push local->cloud sync batches, and the per-shop API key
# issued by the Super Admin app when this shop was created there.
CLOUD_SYNC_URL=https://cloud.example.com
CLOUD_SYNC_API_KEY=

# Cloud mode only: comma separated per-shop API keys accepted on /api/sync/ingest,
# in the form shopId:key,shopId2:key2 (a real deployment would look these up from the
# shops collection instead - see src/middleware/auth.js requireShopApiKey).
CLOUD_SHOP_API_KEYS=

# CORS - comma separated list of allowed origins (LAN devices generally don't send an
# Origin header for plain HTTP API calls, this mainly matters for the web-based
# Super Admin app in cloud mode).
CORS_ORIGINS=*

# Set to "true" to log every request (GET /api/health 200 3ms ...) - off by default so
# a shop running this unattended for a full shift doesn't spam its console/log file
# with health-check polls. Turn on temporarily for debugging.
HTTP_LOG=

# Local mode only: this shop's signed license key, generated from the Super Admin
# dashboard's shop detail page. Missing/invalid/wrong-machine shows a warning banner in
# the Admin app - it never blocks the server from starting (see src/utils/license.js).
LICENSE_KEY=

# Cloud mode only: the PRIVATE half of the RSA keypair used to sign license keys. Never
# copy this into any shop's local .env - only the public half (baked into
# src/utils/license.js) ships with local installs. Generate a keypair with:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('rsa',{modulusLength:2048});console.log(privateKey.export({type:'pkcs8',format:'pem'}))"
LICENSE_PRIVATE_KEY=



