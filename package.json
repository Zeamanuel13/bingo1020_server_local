{
  "name": "bingo1020_server",
  "version": "1.0.0",
  "description": "1020 Bingo House Card Management System - backend (local + cloud mode)",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm install --prefix superadmin && npm run build --prefix superadmin",
    "import:cartelas": "node scripts/importCartelas.js",
    "create:admin": "node scripts/createAdmin.js",
    "create:superadmin": "node scripts/createSuperAdmin.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "node-machine-id": "^1.1.12",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  }
}
